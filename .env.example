# OpenFoodFacts Service Configuration

# PostgreSQL Database Password
POSTGRES_PASSWORD=your_secure_password_here

# API Keys (comma-separated list)
# These keys are required in the X-API-Key header for all API requests
API_KEYS=your_api_key_here,another_key_here

# Image Tag (for Dockge deployment only)
# Options: latest, v1.0.0, or specific git commit SHA
IMAGE_TAG=latest

# Optional: Override default URLs (usually not needed)
# OFF_DELTA_URL=https://static.openfoodfacts.org/data/delta
# OFF_PARQUET_URL=https://huggingface.co/datasets/openfoodfacts/product-database/resolve/main/food.parquet
